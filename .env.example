# Copy to .env. Never commit credentials. Default mode never sends.
SEND_ENABLED=false
# Optional: during controlled testing, messages for any other customer are held.
# Enter digits only, for example 919876543210. Remove after test sign-off.
TEST_RECIPIENT=
# Optional: restrict a controlled test to one booking ID. Remove after sign-off.
TEST_BOOKING_ID=
# Re-evaluate held mail after correcting configuration; keep false in normal use.
RETRY_HELD=false
IMAP_HOST=imap.gmail.com
IMAP_USER=enquiry@entartica.com
IMAP_PASSWORD=
# Alternatively supply an OAuth access token (must be refreshed externally).
IMAP_ACCESS_TOKEN=
IMAP_MAILBOX=INBOX
# Receiving provider authentication-results identity; confirm using received mail.
TRUSTED_AUTHSERV_ID=mx.google.com
POLL_SECONDS=60
# Required before live sending: ISO timestamp; older mail will be ignored.
PROCESS_AFTER=
EXOTEL_HOST=api.in.exotel.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Optional current-account fallback. For a multi-location deployment, use the
# EXOTEL_<CREDENTIAL_KEY>_* variables below instead.
EXOTEL_RAJSAMAND_HOST=api.exotel.com
EXOTEL_RAJSAMAND_ACCOUNT_SID=
EXOTEL_RAJSAMAND_API_KEY=
EXOTEL_RAJSAMAND_API_TOKEN=
EXOTEL_COIMBATORE_HOST=api.exotel.com
EXOTEL_COIMBATORE_ACCOUNT_SID=
EXOTEL_COIMBATORE_API_KEY=
EXOTEL_COIMBATORE_API_TOKEN=
EXOTEL_PRAYAGRAJ_HOST=api.exotel.com
EXOTEL_PRAYAGRAJ_ACCOUNT_SID=
EXOTEL_PRAYAGRAJ_API_KEY=
EXOTEL_PRAYAGRAJ_API_TOKEN=
EXOTEL_RAIPUR_HOST=api.exotel.com
EXOTEL_RAIPUR_ACCOUNT_SID=
EXOTEL_RAIPUR_API_KEY=
EXOTEL_RAIPUR_API_TOKEN=
# Optional delivery-report callback. STATUS_CALLBACK_URL must be a public HTTPS URL.
STATUS_CALLBACK_URL=
# Railway supplies RAILWAY_PUBLIC_DOMAIN after a public domain is generated.
# Set PUBLIC_BASE_URL instead when hosting on another platform.
PUBLIC_BASE_URL=
CALLBACK_PORT=8787
CALLBACK_SECRET=
